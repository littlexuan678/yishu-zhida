# ---------------------------------------------------------------------------
# 说明：本机 pnpm 11 在 Windows 下使用默认的 isolated（符号链接）布局时，
# 出现过后端解析异常（vite 找不到 rollup / esbuild / @vue/compiler-core 等传递依赖）。
# 这里固定为 hoisted（扁平）布局，等价 npm 的 node_modules，兼容性最好。
# 如果你的环境一切正常，也可以删除或注释下面这一行。
# ---------------------------------------------------------------------------
node-linker=hoisted
strict-peer-dependencies=false
