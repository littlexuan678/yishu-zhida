# =============================================================================
# 医数智答 · 智愈医典 —— 环境变量模板
# 复制为 backend/.env 后按需修改
# =============================================================================

# ------------------------- 应用基础配置 -------------------------
APP_NAME=医数智答·智愈医典
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=true
HOST=0.0.0.0
PORT=8000
# 允许跨域的前端地址（多个用英文逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173

# ------------------------- Neo4j 5.8 图数据库 -------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123
NEO4J_DATABASE=neo4j
# 连接池
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=15
# 查不到 Neo4j 时是否降级到内置内存图（演示保底，必须为 true 才能离线演示）
NEO4J_FALLBACK_TO_MEMORY=true

# ------------------------- 大语言模型（Llama 3）-------------------------
# 可选值：openai_compatible | ollama | template
#   openai_compatible -> 任意兼容 OpenAI 协议的端点（vLLM / DeepSeek / 通义 等）
#   ollama            -> 本地 Ollama
#   template          -> 完全离线模板生成（无大模型，仅用 KG 三元组拼装答案）
LLM_PROVIDER=template
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3:8b-instruct-q4_K_M
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=60
# Llama 3 医疗 LoRA 适配器路径（可选）
LLM_LORA_PATH=

# ------------------------- 模型路径（不下载则自动规则降级）-------------------------
MODEL_DIR=./models
NER_MODEL_PATH=./models/ner_bert_bilstm_crf
PCNN_MODEL_PATH=./models/pcnn_attention
INTENT_MODEL_PATH=./models/intent_textcnn
RISK_MODEL_PATH=./models/risk_xgboost.json
EMBEDDING_MODEL_PATH=./models/text2vec-base-chinese
BERT_BASE_PATH=./models/bert-base-chinese

# ------------------------- RAG 检索参数 -------------------------
RAG_TOP_K=12
RAG_MAX_HOPS=2
RAG_MIN_CONFIDENCE=0.55
# 幻觉守卫：答案中的医学实体必须出现在上下文中
RAG_HALLUCINATION_GUARD=true
RAG_PROMPT_LIBRARY=./app/llm_layer/rag/prompt_library.yaml

# ------------------------- 数据层 / 爬虫 -------------------------
# PubMed E-utilities（无需 key 也可用，有 key 速率更高）
PUBMED_API_KEY=
PUBMED_EMAIL=medical-kg@example.com
PUBMED_TOOL=ZhiyuMedicalCodex
CRAWLER_MAX_PAGES=20
CRAWLER_DELAY=1.0
CRAWLER_CONCURRENT=8
USER_AGENT_ROTATE=true
# 语料落盘目录
CORPUS_DIR=./data/processed

# ------------------------- 隐私合规 -------------------------
# AES-256-GCM 主密钥（32 字节，base64 编码）。生产环境请用 KMS 注入！
# 生成方式：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPT_KEY=
# 脱敏开关（演示原型保持 true）
PRIVACY_MASK_ENABLED=true
PRIVACY_ENCRYPT_ENABLED=true

# ------------------------- 限流与安全 -------------------------
RATE_LIMIT_PER_MINUTE=60
CYPHER_READONLY_WHITELIST=true

# ------------------------- 日志 -------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
