# =============================================================================
#  医数智答 · 智愈医典 —— 后端环境变量（开发环境模板）
#  使用：copy .env.example .env  然后按需修改
#  注意：本文件不含任何真实密钥，请勿把生产密钥提交到版本库
# =============================================================================

# ------------------------- 应用基础配置 -------------------------
APP_NAME=医数智答·智愈医典
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173

# ------------------------- Neo4j 5.8 图数据库 -------------------------
# 未启动 Neo4j 时系统会自动降级到内存图存储（离线演示模式），功能不受影响
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=medical123
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=15
# 演示保底：必须为 true，否则 Neo4j 不可用时图谱接口将返回空数据
NEO4J_FALLBACK_TO_MEMORY=true

# ------------------------- 大语言模型（Llama 3）-------------------------
# 可选值：openai_compatible | ollama | template
#   template          -> 完全离线模板生成（无需 GPU，开箱即用）
#   ollama            -> 本地 Ollama（推荐答辩演示）
#   openai_compatible -> vLLM / DeepSeek / 通义 等兼容 OpenAI 协议的端点
LLM_PROVIDER=template
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3:8b-instruct-q4_K_M
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600
LLM_TIMEOUT=60
# Llama 3 医疗领域 LoRA 适配器路径（先用 finetune_lora.py 训练）
LLM_LORA_PATH=

# ------------------------- 模型路径（不下载则自动规则降级）-------------------------
MODEL_DIR=./models
NER_MODEL_PATH=./models/ner_bert_bilstm_crf
PCNN_MODEL_PATH=./models/pcnn_attention
INTENT_MODEL_PATH=./models/intent_textcnn
RISK_MODEL_PATH=./models/risk_xgboost.json
EMBEDDING_MODEL_PATH=./models/text2vec-base-chinese
BERT_BASE_PATH=./models/bert-base-chinese

# ------------------------- RAG 检索参数 -------------------------
RAG_TOP_K=12
RAG_MAX_HOPS=2
RAG_MIN_CONFIDENCE=0.55
# 幻觉守卫：答案中的医学实体必须出现在注入的 KG 上下文中
RAG_HALLUCINATION_GUARD=true
RAG_PROMPT_LIBRARY=./app/llm_layer/rag/prompt_library.yaml

# ------------------------- 数据层 / 爬虫 -------------------------
PUBMED_API_KEY=
PUBMED_EMAIL=medical-kg@example.com
PUBMED_TOOL=ZhiyuMedicalCodex
CRAWLER_MAX_PAGES=20
CRAWLER_DELAY=1.0
CRAWLER_CONCURRENT=8
USER_AGENT_ROTATE=true
CORPUS_DIR=./data/processed

# ------------------------- 隐私合规 -------------------------
# AES-256-GCM 主密钥（32 字节，base64）。留空时开发环境会自动生成临时密钥；
# 生产环境必须通过 KMS/Secrets 注入固定密钥，否则重启后旧密文无法解密。
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPT_KEY=
PRIVACY_MASK_ENABLED=true
PRIVACY_ENCRYPT_ENABLED=true

# ------------------------- 限流与安全 -------------------------
RATE_LIMIT_PER_MINUTE=60
CYPHER_READONLY_WHITELIST=true

# ------------------------- 日志 -------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
